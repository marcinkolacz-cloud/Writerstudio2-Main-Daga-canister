type TextAnnotation = 
 record {
   alternativeProposal: opt text;
   analysisId: nat;
   approved: bool;
   color: text;
   explanation: text;
   id: nat;
   proposal: text;
   "text": text;
 };
type Recording = 
 record {
   audioData: blob;
   bookId: nat;
   chapterId: nat;
   createdAt: int;
   id: nat;
   voice: text;
 };
type InviteCode = 
 record {
   code: text;
   createdAt: int;
   usedAt: opt int;
   usedBy: opt principal;
 };
type Comment = 
 record {
   anchorText: text;
   chapterId: nat;
   content: text;
   createdAt: int;
   id: nat;
 };
type ChatSessionMessage = 
 record {
   content: text;
   createdAt: int;
   id: nat;
   role: text;
   sessionId: nat;
 };
type ChatSession = 
 record {
   chapterId: nat;
   createdAt: int;
   id: nat;
   title: text;
 };
type ChatMessage = 
 record {
   bookId: nat;
   content: text;
   createdAt: int;
   id: nat;
   provider: text;
   role: text;
 };
type Chapter = 
 record {
   bookId: nat;
   charCount: nat;
   content: text;
   createdAt: int;
   id: nat;
   indentFirstLine: nat;
   indentLeft: nat;
   indentRight: nat;
   orderIndex: nat;
   title: text;
   updatedAt: int;
   wordCount: nat;
 };
type Book = 
 record {
   ageCategory: text;
   authorSummary: text;
   category: text;
   createdAt: int;
   description: text;
   id: nat;
   keyContext: text;
   ownerId: principal;
   themes: text;
   title: text;
   updatedAt: int;
   writingStyle: text;
 };
type Analysis = 
 record {
   analysisType: text;
   bookId: nat;
   chapterId: opt nat;
   createdAt: int;
   id: nat;
   provider: text;
   resultContent: text;
 };
service : {
  __analyses: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Analysis;
        }) query;
  __annotations: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          TextAnnotation;
        }) query;
  __books: (ko: opt nat, count: opt nat) -> (vec record {
                                                   nat;
                                                   Book;
                                                 }) query;
  __chapters: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Chapter;
        }) query;
  __chatMessages: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatMessage;
        }) query;
  __chatSessionMessages: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatSessionMessage;
        }) query;
  __chatSessions: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatSession;
        }) query;
  __comments: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Comment;
        }) query;
  __inviteCodes: (ko: opt text, count: opt nat) ->
   (vec record {
          text;
          InviteCode;
        }) query;
  __nextAnalysisId: () -> (nat) query;
  __nextAnnotationId: () -> (nat) query;
  __nextBookId: () -> (nat) query;
  __nextChapterId: () -> (nat) query;
  __nextChatMessageId: () -> (nat) query;
  __nextChatSessionId: () -> (nat) query;
  __nextChatSessionMessageId: () -> (nat) query;
  __nextCommentId: () -> (nat) query;
  __nextRecordingId: () -> (nat) query;
  __recordings: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Recording;
        }) query;
  addChatMessage: (sessionId: nat, role: text, content: text) -> (nat);
  checkAccess: (code: text) -> (bool);
  clearChat: (bookId: nat) -> (bool);
  createBook: (title: text, description: text, category: text) -> (nat);
  createChapter: (bookId: nat, title: text) -> (nat);
  createChatSession: (chapterId: nat, title: text) -> (nat);
  createComment: (chapterId: nat, anchorText: text, content: text) -> (nat);
  deleteAnalysis: (id: nat) -> (bool);
  deleteBook: (id: nat) -> (bool);
  deleteChapter: (id: nat) -> (bool);
  deleteChatSession: (sessionId: nat) -> ();
  deleteComment: (id: nat) -> (bool);
  deleteMessage: (id: nat) -> (bool);
  deleteRecording: (id: nat) -> (bool);
  generateInviteCode: () -> (text);
  getAnalysis: (id: nat) -> (opt Analysis);
  getAnnotation: (id: nat) -> (opt TextAnnotation);
  getAnnotations: (analysisId: nat) -> (vec TextAnnotation);
  getBook: (id: nat) -> (opt Book);
  getBookStats: (bookId: nat) ->
   (record {
      avgWordsPerChapter: nat;
      chapterCount: nat;
      totalChars: nat;
      totalWords: nat;
    });
  getChapter: (id: nat) -> (opt Chapter);
  getChatMessages: (sessionId: nat) -> (vec ChatSessionMessage);
  getChatSessionsByChapter: (chapterId: nat) -> (vec ChatSession);
  getOverallStats: () ->
   (record {
      totalBooks: nat;
      totalChapters: nat;
      totalWords: nat;
    });
  getRecordingAudio: (id: nat) -> (opt blob);
  listAnalysesByBook: (bookId: nat) -> (vec Analysis);
  listAnalysesByChapter: (chapterId: nat) -> (vec Analysis);
  listAnnotationsByAnalysis: (analysisId: nat) -> (vec TextAnnotation);
  listBooksByOwner: () -> (vec Book);
  listChaptersByBook: (bookId: nat) -> (vec Chapter);
  listCommentsByChapter: (chapterId: nat) -> (vec Comment);
  listInviteCodes: () -> (vec InviteCode);
  listMessagesByBook: (bookId: nat) -> (vec ChatMessage);
  listRecordingsByChapter: (chapterId: nat) ->
   (vec record {
          createdAt: int;
          id: nat;
          voice: text;
        });
  reorderChapters: (bookId: nat, orderedIds: vec nat) -> (bool);
  revokeInviteCode: (code: text) -> ();
  saveAnalysis: (bookId: nat, chapterId: opt nat, analysisType: text,
   provider: text, resultContent: text) -> (nat);
  saveAnnotations: (analysisId: nat, annotationData:
   vec
    record {
      alternativeProposal: opt text;
      color: text;
      explanation: text;
      proposal: text;
      "text": text;
    }) -> (vec nat);
  saveRecording: (chapterId: nat, bookId: nat, voice: text, audioData:
   blob) -> (nat);
  sendMessage: (bookId: nat, role: text, content: text, provider: text) ->
   (nat);
  updateAnnotationApproved: (id: nat, approved: bool) -> (bool);
  updateBook: (id: nat, title: text, description: text, category: text) ->
   (bool);
  updateBookMetadata: (id: nat, ageCategory: text, authorSummary: text,
   keyContext: text, themes: text, writingStyle: text) -> (bool);
  updateChapter: (id: nat, title: text, content: text) -> (bool);
  updateChapterIndents: (id: nat, indentLeft: nat, indentRight: nat,
   indentFirstLine: nat) -> (bool);
}
