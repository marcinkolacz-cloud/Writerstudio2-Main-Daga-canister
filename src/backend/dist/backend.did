type TextAnnotation = 
 record {
   alternativeProposal: opt text;
   analysisId: nat;
   approved: bool;
   color: text;
   explanation: text;
   id: nat;
   proposal: text;
   "text": text;
 };
type Recording = 
 record {
   audioData: vec nat8;
   bookId: nat;
   chapterId: nat;
   createdAt: int;
   id: nat;
   voice: text;
 };
type PendingUpload = 
 record {
   bookId: nat;
   chapterId: nat;
   createdAt: int;
   id: nat;
   receivedChunks: nat;
   totalChunks: nat;
   voice: text;
 };
type InviteCode = 
 record {
   code: text;
   createdAt: int;
   usedAt: opt int;
   usedBy: opt principal;
 };
type HourlyActivityStat = 
 record {
   hour: nat;
   id: nat;
   ownerId: principal;
   wordsAdded: nat;
 };
type ExportMetadataResponse = 
 record {
   bookCount: nat;
   exportedAt: int;
   owner: principal;
 };
type DailyWritingStat = 
 record {
   activeMinutes: nat;
   bookId: nat;
   date: text;
   id: nat;
   netWords: int;
   ownerId: principal;
   sessionCount: nat;
   wordsAdded: nat;
   wordsRemoved: nat;
 };
type Comment = 
 record {
   anchorText: text;
   chapterId: nat;
   content: text;
   createdAt: int;
   id: nat;
 };
type ChatSessionMessage = 
 record {
   content: text;
   createdAt: int;
   id: nat;
   role: text;
   sessionId: nat;
 };
type ChatSession = 
 record {
   chapterId: nat;
   createdAt: int;
   id: nat;
   title: text;
 };
type ChatMessage = 
 record {
   bookId: nat;
   content: text;
   createdAt: int;
   id: nat;
   provider: text;
   role: text;
   sessionId: text;
 };
type ChatArchive = 
 record {
   bookId: nat;
   createdAt: int;
   id: nat;
   sessionId: text;
   summary: text;
   title: text;
   updatedAt: int;
 };
type Chapter = 
 record {
   bookId: nat;
   charCount: nat;
   content: text;
   createdAt: int;
   id: nat;
   indentFirstLine: nat;
   indentLeft: nat;
   indentRight: nat;
   orderIndex: nat;
   sessionId: text;
   title: text;
   updatedAt: int;
   wordCount: nat;
 };
type BookExport = 
 record {
   analyses: vec Analysis;
   annotations: vec TextAnnotation;
   book: Book;
   chapters: vec Chapter;
   chatArchives: vec ChatArchive;
   chatMessages: vec ChatMessage;
   chatSessionMessages: vec ChatSessionMessage;
   chatSessions: vec ChatSession;
   comments: vec Comment;
 };
type Book = 
 record {
   ageCategory: text;
   authorSummary: text;
   category: text;
   characters: text;
   description: text;
   id: nat;
   keyContext: text;
   ownerId: principal;
   themes: text;
   title: text;
   updatedAt: int;
 };
type BackupSnapshot = 
 record {
   analyses: vec Analysis;
   annotations: vec TextAnnotation;
   books: vec Book;
   chapters: vec Chapter;
   comments: vec Comment;
   timestamp: int;
 };
type Analysis = 
 record {
   analysisType: text;
   bookId: nat;
   chapterId: opt nat;
   createdAt: int;
   id: nat;
   provider: text;
   resultContent: text;
 };
service : {
  __adminPrincipal: () -> (opt principal) query;
  __analyses: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Analysis;
        }) query;
  __analysesTrashed: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          int;
        }) query;
  __annotations: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          TextAnnotation;
        }) query;
  __backupEnabled: () -> (bool) query;
  __backupIntervalSeconds: () -> (nat) query;
  __backupMaxSnapshots: () -> (nat) query;
  __backupSnapshots: (ko: opt int, count: opt nat) ->
   (vec record {
          int;
          BackupSnapshot;
        }) query;
  __backupTimerId: () -> (nat) query;
  __books: (ko: opt nat, count: opt nat) -> (vec record {
                                                   nat;
                                                   Book;
                                                 }) query;
  __booksTrashed: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          int;
        }) query;
  __chapters: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Chapter;
        }) query;
  __chaptersTrashed: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          int;
        }) query;
  __chatArchives: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatArchive;
        }) query;
  __chatMessages: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatMessage;
        }) query;
  __chatSessionMessages: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatSessionMessage;
        }) query;
  __chatSessions: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          ChatSession;
        }) query;
  __comments: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Comment;
        }) query;
  __commentsTrashed: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          int;
        }) query;
  __hourlyStats: (ko: opt text, count: opt nat) ->
   (vec record {
          text;
          HourlyActivityStat;
        }) query;
  __inviteCodes: (ko: opt text, count: opt nat) ->
   (vec record {
          text;
          InviteCode;
        }) query;
  __nextAnalysisId: () -> (nat) query;
  __nextAnnotationId: () -> (nat) query;
  __nextBookId: () -> (nat) query;
  __nextChapterId: () -> (nat) query;
  __nextChatArchiveId: () -> (nat) query;
  __nextChatMessageId: () -> (nat) query;
  __nextChatSessionId: () -> (nat) query;
  __nextChatSessionMessageId: () -> (nat) query;
  __nextCommentId: () -> (nat) query;
  __nextRecordingId: () -> (nat) query;
  __pendingUploads: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          PendingUpload;
        }) query;
  __recordingNames: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          text;
        }) query;
  __recordings: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          Recording;
        }) query;
  __recordingsTrashed: (ko: opt nat, count: opt nat) ->
   (vec record {
          nat;
          int;
        }) query;
  __uploadChunks: (ko: opt text, count: opt nat) ->
   (vec record {
          text;
          vec nat8;
        }) query;
  __writingStats: (ko: opt text, count: opt nat) ->
   (vec record {
          text;
          DailyWritingStat;
        }) query;
  addChatMessage: (sessionId: nat, role: text, content: text) -> (nat);
  adminGetAllIds: () ->
   (record {
      analyses: vec nat;
      annotations: vec nat;
      books: vec nat;
      chapters: vec nat;
      chatArchives: vec nat;
      chatMessages: vec nat;
      chatSessionMessages: vec nat;
      chatSessions: vec nat;
      comments: vec nat;
      hourlyStatsKeys: vec text;
      writingStatsKeys: vec text;
    }) query;
  adminImportAnalysis: (analysis: Analysis) -> ();
  adminImportAnnotation: (annotation: TextAnnotation) -> ();
  adminImportBook: (book: Book) -> ();
  adminImportChapter: (chapter: Chapter) -> ();
  adminImportChatArchive: (archive: ChatArchive) -> ();
  adminImportChatMessage: (msg: ChatMessage) -> ();
  adminImportChatSession: (session: ChatSession) -> ();
  adminImportChatSessionMessage: (msg: ChatSessionMessage) -> ();
  adminImportComment: (comment: Comment) -> ();
  adminImportDailyWritingStat: (stat: DailyWritingStat) -> ();
  adminImportHourlyActivityStat: (stat: HourlyActivityStat) -> ();
  adminReassignBooksOwner: (bookIds: vec nat, newOwner: principal) -> (nat);
  checkAccess: (code: text) -> (bool);
  clearChat: (bookId: nat, sessionId: text) -> (bool);
  createArchive: (bookId: nat, sessionId: text, title: text) -> (nat);
  createBook: (title: text, description: text, category: text) -> (nat);
  createChapter: (bookId: nat, title: text) -> (nat);
  createChatSession: (chapterId: nat, title: text) -> (nat);
  createComment: (chapterId: nat, anchorText: text, content: text) -> (nat);
  deleteAnalysis: (id: nat) -> (bool);
  deleteArchive: (id: nat) -> (bool);
  deleteBook: (id: nat) -> (bool);
  deleteChapter: (id: nat) -> (bool);
  deleteChatSession: (sessionId: nat) -> ();
  deleteComment: (id: nat) -> (bool);
  deleteMessage: (id: nat) -> (bool);
  deleteRecording: (id: nat) -> (bool);
  exportBookSlice: (bookIndex: nat) -> (opt BookExport) query;
  exportMetadata: () -> (ExportMetadataResponse) query;
  finishRecordingUpload: (uploadId: nat) -> (nat);
  generateInviteCode: () -> (text);
  getAnalysis: (id: nat) -> (opt Analysis);
  getAnnotation: (id: nat) -> (opt TextAnnotation);
  getAnnotations: (analysisId: nat) -> (vec TextAnnotation);
  getBook: (id: nat) -> (opt Book);
  getBookStats: (bookId: nat) ->
   (record {
      avgWordsPerChapter: nat;
      chapterCount: nat;
      totalChars: nat;
      totalWords: nat;
    });
  getChapter: (id: nat) -> (opt Chapter);
  getChatMessages: (sessionId: nat) -> (vec ChatSessionMessage);
  getChatSessionsByChapter: (chapterId: nat) -> (vec ChatSession);
  getGlobalStats: (fromDate: text, toDate: text) -> (vec DailyWritingStat);
  getHourlyDistribution: () -> (vec HourlyActivityStat);
  getOverallStats: () ->
   (record {
      totalBooks: nat;
      totalChapters: nat;
      totalWords: nat;
    });
  getRecordingAudio: (id: nat) -> (opt vec nat8);
  getStatsByBook: (bookId: nat, fromDate: text, toDate: text) ->
   (vec DailyWritingStat);
  listAnalysesByBook: (bookId: nat) -> (vec Analysis);
  listAnalysesByChapter: (chapterId: nat) -> (vec Analysis);
  listAnnotationsByAnalysis: (analysisId: nat) -> (vec TextAnnotation);
  listArchivesByBook: (bookId: nat) -> (vec ChatArchive);
  listBooksByOwner: () -> (vec Book);
  listChaptersByBook: (bookId: nat) -> (vec Chapter);
  listCommentsByChapter: (chapterId: nat) -> (vec Comment);
  listInviteCodes: () -> (vec InviteCode);
  listMessagesByBook: (bookId: nat, sessionId: text) -> (vec ChatMessage);
  listRecordingsByChapter: (chapterId: nat) ->
   (vec record {
          createdAt: int;
          id: nat;
          name: opt text;
          voice: text;
        });
  listTrashedAnalysesByBook: (bookId: nat) -> (vec Analysis);
  listTrashedBooks: () -> (vec Book);
  listTrashedChaptersByBook: (bookId: nat) -> (vec Chapter);
  listTrashedCommentsByChapter: (chapterId: nat) -> (vec Comment);
  listTrashedRecordingsByChapter: (chapterId: nat) ->
   (vec record {
          createdAt: int;
          id: nat;
          name: opt text;
          voice: text;
        });
  permanentlyDeleteAnalysis: (id: nat) -> (bool);
  permanentlyDeleteBook: (id: nat) -> (bool);
  permanentlyDeleteChapter: (id: nat) -> (bool);
  permanentlyDeleteComment: (id: nat) -> (bool);
  permanentlyDeleteRecording: (id: nat) -> (bool);
  recordHourlyActivity: (hour: nat, wordsAdded: nat) -> ();
  recordWritingActivity: (bookId: nat, date: text, wordsAdded: nat,
   wordsRemoved: nat, activeMinutes: nat) -> ();
  renameArchive: (id: nat, newTitle: text) -> (bool);
  reorderChapters: (bookId: nat, orderedIds: vec nat) -> (bool);
  resetMyHourlyStats: () -> ();
  resetMyWritingStats: () -> ();
  restoreAnalysis: (id: nat) -> (bool);
  restoreBook: (id: nat) -> (bool);
  restoreChapter: (id: nat) -> (bool);
  restoreComment: (id: nat) -> (bool);
  restoreRecording: (id: nat) -> (bool);
  revokeInviteCode: (code: text) -> (bool);
  saveAnalysis: (bookId: nat, chapterId: opt nat, analysisType: text,
   provider: text, resultContent: text) -> (nat);
  saveAnnotations: (analysisId: nat, annotationData:
   vec
    record {
      alternativeProposal: opt text;
      color: text;
      explanation: text;
      proposal: text;
      "text": text;
    }) -> (vec nat);
  saveRecording: (chapterId: nat, bookId: nat, voice: text, audioData:
   vec nat8) -> (nat);
  sendMessage: (bookId: nat, sessionId: text, role: text, content: text,
   provider: text) -> (nat);
  setAdminPrincipal: (p: principal) -> ();
  setArchiveSummary: (id: nat, summary: text) -> (bool);
  setRecordingName: (recordingId: nat, name: text) -> (bool);
  startRecordingUpload: (chapterId: nat, bookId: nat, voice: text,
   totalChunks: nat) -> (nat);
  synthesizeSpeech: ("text": text, voice: text, apiKey: text) -> (blob);
  ttsTransform: (raw:
   record {
     context: blob;
     response:
      record {
        body: blob;
        headers: vec record {
                       name: text;
                       value: text;
                     };
        status: nat;
      };
   }) ->
   (record {
      body: blob;
      headers: vec record {
                     name: text;
                     value: text;
                   };
      status: nat;
    }) query;
  updateAnnotationApproved: (id: nat, approved: bool) -> (bool);
  updateBook: (id: nat, title: text, description: text, category: text) ->
   (bool);
  updateBookCharacters: (id: nat, characters: text) -> (bool);
  updateBookMetadata: (id: nat, ageCategory: text, authorSummary: text,
   keyContext: text, themes: text, writingStyle: text) -> (bool);
  updateChapter: (id: nat, title: text, content: text) -> (bool);
  updateChapterIndents: (id: nat, indentLeft: nat, indentRight: nat,
   indentFirstLine: nat) -> (bool);
  uploadRecordingChunk: (uploadId: nat, chunkIndex: nat, data: vec nat8) ->
   (bool);
}
